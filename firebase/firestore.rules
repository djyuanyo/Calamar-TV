rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function administrator() {
      return request.auth != null
        && request.auth.token.email == 'juanjocarrillo7@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validCatalog() {
      let catalog = request.resource.data;
      return catalog.keys().hasAll(['json', 'revision', 'updatedAt'])
        && catalog.keys().hasOnly(['json', 'revision', 'updatedAt'])
        && catalog.json is string
        && catalog.json.size() <= 500000
        && catalog.revision is int
        && catalog.updatedAt == request.time;
    }
    match /calamarCatalog/custom {
      allow get: if true;
      allow create: if administrator() && validCatalog() && request.resource.data.revision == 1;
      allow update: if administrator() && validCatalog()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete, list: if false;
    }
    // Live viewers: one document per open player, refreshed every minute and deleted on close.
    // Only the channel, event or film/series (l:) being watched is stored, never who is watching.
    function validPresence(session) {
      let p = request.resource.data;
      return session.matches('^[A-Za-z0-9]{20,40}$')
        && p.keys().hasAll(['target', 'minute', 'beat', 'updatedAt'])
        && p.keys().hasOnly(['target', 'minute', 'beat', 'updatedAt'])
        && p.target is string && p.target.matches('^[cel]:[^|/]{1,200}$')
        && p.minute is int && math.abs(p.minute * 60000 - request.time.toMillis()) <= 180000
        && p.beat == p.target + '|' + string(p.minute)
        && p.updatedAt == request.time;
    }
    match /calamarAudience/{session} {
      allow read: if true;
      allow create, update: if validPresence(session);
      allow delete: if true;
    }
    // Visits per Madrid day: anyone may add exactly one visit to one channel, event or film/series of today.
    // `last` names the counter being increased, because rules cannot read a key out of a set.
    function oneVisit(day, before) {
      let p = request.resource.data;
      let date = timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
      return day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && math.abs(date.toMillis() - request.time.toMillis()) <= 172800000
        && p.last is string && p.last.matches('^[cel]_[A-Za-z0-9_-]{1,140}$')
        && p.diff(before).affectedKeys().hasOnly([p.last, 'last'])
        && p[p.last] == before.get(p.last, 0) + 1;
    }
    match /calamarVisits/{day} {
      allow read: if administrator();
      allow create: if oneVisit(day, {});
      allow update: if oneVisit(day, resource.data);
      allow delete: if false;
    }
    // Films, series and documentaries (Google Drive videos with TMDB data), published by the admin web
    // page in parts of up to 900 KB: «index» names the parts of each section («movies-0», «series-1»…).
    function validLibraryPart(part) {
      let p = request.resource.data;
      return part.matches('^(index|[a-z]{3,20}-[0-9]{1,3})$')
        && p.keys().hasAll(['json', 'updatedAt'])
        && p.keys().hasOnly(['json', 'updatedAt'])
        && p.json is string
        && p.json.size() <= 900000
        && p.updatedAt == request.time;
    }
    match /calamarLibrary/{part} {
      allow get: if true;
      allow create, update: if administrator() && validLibraryPart(part);
      allow delete: if administrator();
      allow list: if false;
    }
    // The administrator's library settings: TMDB key and Google Drive folders. Never public.
    match /calamarPrivate/library {
      allow get, create, update: if administrator();
      allow delete, list: if false;
    }
    // An app signing in from a phone: the Google ID token of whoever confirms the code (any Google
    // account; the administrator's too) under <app key><code> (8 characters, both needed to read it),
    // readable for 5 minutes and deleted by the app once used.
    match /calamarDeviceLogins/{id} {
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && id.matches('^[2-9A-HJ-NP-Z]{8}$')
        && request.resource.data.keys().hasOnly(['idToken', 'createdAt'])
        && request.resource.data.idToken is string
        && request.resource.data.idToken.size() < 4096
        && request.resource.data.createdAt == request.time;
      allow get: if request.time < resource.data.createdAt + duration.value(5, 'm');
      allow delete: if true;
      allow update, list: if false;
    }
    // «Continuar viendo» of each signed-in account, shared by its web and app sessions: only that
    // account reads or writes its own document.
    match /calamarProgress/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['json', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 200000
        && request.resource.data.updatedAt == request.time;
      allow list: if false;
    }
    // Accounts (Google or email and password): the profiles of each account and, per profile, its
    // «Continuar viendo» (the main profile keeps calamarProgress/<uid>), My list, likes and favourite
    // channels. Only that account reads or writes them.
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function jsonDoc(limit) {
      let p = request.resource.data;
      return p.keys().hasAll(['json', 'updatedAt']) && p.keys().hasOnly(['json', 'updatedAt'])
        && p.json is string && p.json.size() <= limit && p.updatedAt == request.time;
    }
    match /calamarUsers/{uid} {
      allow get, delete: if owner(uid);
      allow create, update: if owner(uid) && jsonDoc(20000);
      allow list: if false;
      match /profiles/{profile} {
        allow get, delete: if owner(uid);
        allow create, update: if owner(uid) && profile.matches('^[a-z0-9]{1,20}$') && jsonDoc(200000);
        allow list: if false;
      }
      match /progress/{profile} {
        allow get, delete: if owner(uid);
        allow create, update: if owner(uid) && profile.matches('^[a-z0-9]{1,20}$') && jsonDoc(200000);
        allow list: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
