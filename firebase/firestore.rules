rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function administrator() {
      return request.auth != null
        && request.auth.token.email == 'juanjocarrillo7@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validCatalog() {
      let catalog = request.resource.data;
      return catalog.keys().hasAll(['json', 'revision', 'updatedAt'])
        && catalog.keys().hasOnly(['json', 'revision', 'updatedAt'])
        && catalog.json is string
        && catalog.json.size() <= 500000
        && catalog.revision is int
        && catalog.updatedAt == request.time;
    }
    match /calamarCatalog/custom {
      allow get: if true;
      allow create: if administrator() && validCatalog() && request.resource.data.revision == 1;
      allow update: if administrator() && validCatalog()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete, list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
